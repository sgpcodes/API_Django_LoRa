# Copie este arquivo para ".env" e ajuste os valores conforme necessário.

# Chave secreta do Django. Gere uma nova para produção, por exemplo com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-esta-chave-por-uma-chave-secreta

# "True" em desenvolvimento, "False" em produção.
DEBUG=True

# Domínios permitidos a acessar a API, separados por vírgula.
# Em produção no Render, inclua o domínio gerado, ex: meu-projeto.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# String de conexão do MongoDB.
# Local:            mongodb://localhost:27017
# MongoDB Atlas:     mongodb+srv://usuario:senha@cluster.mongodb.net
MONGO_URI=mongodb://localhost:27017

# Nome do banco de dados dentro do MongoDB.
MONGO_DB_NAME=monitoramento_meteorologico
