# Copie este arquivo para ".env" e ajuste os valores conforme necessário.

# Chave secreta do Django. Gere uma nova para produção, por exemplo com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-esta-chave-por-uma-chave-secreta

# "True" em desenvolvimento, "False" em produção.
DEBUG=True

# Domínios permitidos a acessar a API, separados por vírgula.
# Em produção no Render, inclua o domínio gerado, ex: meu-projeto.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# String de conexão do banco PostgreSQL.
# Local (Docker):    postgresql://usuario:senha@localhost:5432/monitoramento_meteorologico
# Supabase:          pegue em Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/monitoramento_meteorologico

# E-mail de confirmação de cadastro (contas/emails.py). Sem essa chave, o
# e-mail só é impresso no log (backend de console) — nada é enviado de
# verdade. Para enviar de verdade: crie uma conta grátis em
# https://resend.com, gere uma API key e cole aqui.
RESEND_API_KEY=

# Remetente que aparece nos e-mails enviados. "onboarding@resend.dev" é o
# endereço de teste que o Resend libera sem precisar verificar domínio
# próprio — troque depois de verificar seu domínio no painel do Resend.
DEFAULT_FROM_EMAIL=onboarding@resend.dev

# URL pública do frontend (Vercel em produção) — usada para montar o link
# de confirmação de e-mail que a pessoa recebe.
FRONTEND_URL=http://localhost:5173

# Limite de armazenamento do plano do banco, em GB (painel de Manutenção
# mostra "X GB usado / DATABASE_QUOTA_GB GB"). Sem essa variável, a tela
# mostra só o tamanho usado, sem cota — configure com o limite real do
# seu plano (ex.: Supabase).
DATABASE_QUOTA_GB=500
