# Copie este arquivo para .env.docker e ajuste os valores antes de rodar
# `docker compose up -d --build`. O .env.docker é só para a instalação local
# (Raspberry Pi ou Mac/Linux), separado do .env usado no deploy Render/Vercel.

# --- Postgres (container "db") ---
POSTGRES_DB=monitoramento_meteorologico
POSTGRES_USER=lacop
POSTGRES_PASSWORD=troque-esta-senha

# --- Django (container "backend") ---
# Gere uma chave nova, por exemplo com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-esta-chave-secreta
DEBUG=False
# Hosts pelos quais o Nginx pode ser acessado na rede local — inclua o
# hostname da Raspberry Pi (ex.: raspberrypi.local) e/ou o IP fixo dela.
ALLOWED_HOSTS=localhost,127.0.0.1,raspberrypi.local
# Precisa bater com POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB acima — o
# Compose não expande variáveis dentro de arquivos passados via env_file,
# então não dá pra usar ${POSTGRES_USER} aqui, tem que repetir os valores.
DATABASE_URL=postgresql://lacop:troque-esta-senha@db:5432/monitoramento_meteorologico
DB_CONN_MAX_AGE=60
GUNICORN_WORKERS=3

# Quota opcional (em GB) usada pelo painel de Manutenção do admin. Use 0
# para não aplicar limite — diferente do Render, aqui a variável sempre
# chega definida ao container (mesmo vazia), e "" quebra o int() do Django.
DATABASE_QUOTA_GB=0

# E-mail (opcional nesta instalação local — deixe em branco se não for usar)
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=onboarding@resend.dev

# URL pela qual o frontend é acessado, usada nos links dos e-mails enviados
FRONTEND_URL=http://raspberrypi.local

# --- Sincronização com a nuvem (backup local -> Supabase) ---
# Deixe em branco pra rodar só localmente, sem nenhuma sincronização.
# Preenchendo, o backend passa a tentar enviar as leituras acumuladas
# localmente pra nuvem a cada SYNC_INTERVAL_SECONDS (padrão: 300 = 5 min)
# e, após confirmar que cada uma foi salva lá, apaga a cópia local — ver
# docs/rodando-na-raspberry.md e api_rest/management/commands/.
#
# Use a MESMA connection string do Supabase que está configurada no
# Render em DATABASE_URL (pegue no painel do Render ou do Supabase).
CLOUD_DATABASE_URL=
SYNC_INTERVAL_SECONDS=300
